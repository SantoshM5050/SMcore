# ==============================================================================
# SMCore — Environment Variables Configuration Template
# Copy this file to .env and configure with your actual values.
# DO NOT commit .env with secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME="SMCore"
APP_TITLE="SMCore Dashboard"
NODE_ENV="development"
PORT="3001"

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://smcore:smcore_dev_password@localhost:5432/smcore?schema=public"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Web Dashboard & Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-this-to-a-secure-random-secret-key-32-chars-minimum!"

# Discord Developer Portal Credentials
# https://discord.com/developers/applications
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback"
