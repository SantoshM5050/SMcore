# SMCore Discord Bot Configuration
APP_NAME="SMCore"
APP_TITLE="SMCore Dashboard"

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Node Environment
NODE_ENV="development"

# NextAuth / Dashboard Session Secret
NEXTAUTH_URL="http://localhost:3000"
SESSION_SECRET="change-this-to-a-secure-random-secret-key-32-chars-minimum!"

# Discord Developer Portal Credentials
# https://discord.com/developers/applications
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback"
