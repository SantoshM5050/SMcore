generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id          String   @id // Discord Snowflake ID
  name        String
  icon        String?
  ownerId     String   // Discord Snowflake ID of guild owner
  botPresent  Boolean  @default(true)
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings            GuildSettings?
  protectionSettings  GuildProtectionSettings?
  securitySettings    GuildSecuritySettings?
  moderationCases     ModerationCase[]
  warnings            Warning[]
  escalationRules     WarningEscalationRule[]
  memberNotes         MemberNote[]

  @@index([ownerId])
  @@map("guilds")
}

model GuildSettings {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  guild               Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  prefix              String   @default("!")
  language            String   @default("en-US")
  timezone            String   @default("UTC")
  modLogChannelId     String?
  actionLogChannelId  String?
  muteRoleId          String?
  appealUrl           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([guildId])
  @@map("guild_settings")
}

model GuildProtectionSettings {
  id                        String   @id @default(cuid())
  guildId                   String   @unique
  guild                     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Anti-Spam
  antiSpamEnabled           Boolean  @default(false)
  antiSpamMessageLimit      Int      @default(5)
  antiSpamWindowSeconds     Int      @default(5)
  duplicateMessageLimit     Int      @default(3)
  antiSpamPunishment        String   @default("TIMEOUT")

  // Mass Mention
  massMentionEnabled        Boolean  @default(false)
  maxUserMentions           Int      @default(5)
  maxRoleMentions           Int      @default(3)
  maxTotalMentions          Int      @default(6)
  everyoneMentionAllowed    Boolean  @default(false)
  massMentionPunishment     String   @default("TIMEOUT")

  // Discord Invite Filter
  inviteFilterEnabled       Boolean  @default(false)
  allowedInviteGuilds       String[] @default([])
  inviteFilterPunishment    String   @default("DELETE")

  // External Link Filter
  externalLinkFilterEnabled Boolean  @default(false)
  allowedDomains            String[] @default([])
  blockedDomains            String[] @default([])
  externalLinkPunishment    String   @default("DELETE")

  // Prohibited Keywords
  keywordFilterEnabled      Boolean  @default(false)
  prohibitedKeywords        String[] @default([])
  keywordPunishment         String   @default("DELETE")

  deleteViolatingMessages   Boolean  @default(true)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([guildId])
  @@map("guild_protection_settings")
}

model GuildSecuritySettings {
  id                          String   @id @default(cuid())
  guildId                     String   @unique
  guild                       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled                     Boolean  @default(false)

  // Raid Detection & Raid Mode
  raidDetectionEnabled        Boolean  @default(false)
  raidJoinThreshold           Int      @default(10)
  raidWindowSeconds           Int      @default(10)
  raidModeDurationSeconds     Int      @default(300)
  raidAction                  String   @default("QUARANTINE")

  // Suspicious & Young Account Protection
  accountAgeProtectionEnabled  Boolean  @default(false)
  minimumAccountAgeHours      Int      @default(24)
  accountAgeAction            String   @default("QUARANTINE")

  // Role Quarantine Configuration
  quarantineEnabled           Boolean  @default(false)
  quarantineRoleId            String?
  removeRolesOnQuarantine     Boolean  @default(false)
  restoreRolesOnRelease       Boolean  @default(false)

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([guildId])
  @@map("guild_security_settings")
}

model ModerationCase {
  id              String    @id @default(cuid())
  guildId         String
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  caseNumber      Int
  type            String    // BAN, UNBAN, KICK, TIMEOUT, UNTIMEOUT, WARN, PURGE, LOCK, UNLOCK, SLOWMODE, NICKNAME
  targetUserId    String    // Discord Snowflake ID
  moderatorUserId String    // Discord Snowflake ID
  reason          String?
  duration        Int?      // in seconds
  expiresAt       DateTime?
  status          String    @default("ACTIVE") // ACTIVE, COMPLETED, REVOKED, EXPIRED
  metadata        Json?

  warnings        Warning[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetUserId])
  @@index([moderatorUserId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("moderation_cases")
}

model Warning {
  id              String          @id @default(cuid())
  guildId         String
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)

  targetUserId    String          // Discord Snowflake ID
  moderatorUserId String          // Discord Snowflake ID
  reason          String
  status          String          @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt       DateTime?

  caseId          String?
  case            ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([guildId])
  @@index([targetUserId])
  @@index([status])
  @@map("warnings")
}

model WarningEscalationRule {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  warningCount Int
  action       String   // BAN, KICK, TIMEOUT
  duration     Int?     // duration in seconds if action is TIMEOUT
  enabled      Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, warningCount])
  @@index([guildId])
  @@map("warning_escalation_rules")
}

model MemberNote {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  targetUserId String   // Discord Snowflake ID
  authorUserId String   // Discord Snowflake ID (staff member)
  content      String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guildId])
  @@index([targetUserId])
  @@map("member_notes")
}
