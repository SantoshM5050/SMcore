datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ModerationAction {
  BAN
  UNBAN
  KICK
  TIMEOUT
  TIMEOUT_REMOVE
  WARN
  WARN_REMOVE
  PURGE
  LOCK
  UNLOCK
  SLOWMODE
  NICKNAME
  ROLE_MOD
  AUTOMOD
}

enum AutoModType {
  SPAM
  MENTIONS
  EMOJIS
  REPEATED_MESSAGES
  REPEATED_CHARS
  MASS_MESSAGES
  CAPS_ABUSE
  INVITE_LINKS
  SUSPICIOUS_LINKS
  BLOCKED_WORDS
  REGEX
}

enum AutoModAction {
  DELETE
  WARN
  TIMEOUT
  KICK
  BAN
  ALERT
}

enum RaidAction {
  LOCK_CHANNELS
  ALERT_STAFF
  QUARANTINE_NEW_JOINS
}

enum JoinSecurityAction {
  ALLOW
  ALERT
  TIMEOUT
  KICK
  QUARANTINE
}

enum EscalationAction {
  TIMEOUT
  KICK
  BAN
}

enum LogCategory {
  MEMBER
  MODERATION
  VOICE
  CHANNEL
  ROLE
  MESSAGE
  SERVER
}

enum LogDestinationType {
  TEXT_CHANNEL
  FORUM_CHANNEL
}

enum ForumThreadMode {
  CATEGORY
  DAILY
  EVENT_TYPE
  PER_CASE
}

enum StaffPermission {
  VIEW_DASHBOARD
  VIEW_LOGS
  MANAGE_LOGS
  VIEW_MODERATION
  WARN_MEMBERS
  TIMEOUT_MEMBERS
  KICK_MEMBERS
  BAN_MEMBERS
  MANAGE_AUTOMOD
  MANAGE_ANTIRAID
  MANAGE_SETTINGS
}

enum AuditAction {
  SETTINGS_UPDATED
  DASHBOARD_LOGIN
  STAFF_UPDATED
  AUTOMOD_UPDATED
  LOG_CONFIG_UPDATED
  CASE_CREATED
  CASE_UPDATED
  WARNING_CREATED
  WARNING_REMOVED
  RAID_MODE_TOGGLED
}

model Guild {
  id          String   @id
  name        String
  icon        String?
  ownerId     String
  botJoinedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings           GuildSettings?
  staffRoles         StaffRole[]
  moderationCases    ModerationCase[]
  warnings           Warning[]
  escalationRules    WarningEscalationRule[]
  memberNotes        MemberNote[]
  autoModRules       AutoModRule[]
  antiSpamConfig     AntiSpamConfig?
  antiLinkConfig     AntiLinkConfig?
  antiInviteConfig   AntiInviteConfig?
  antiMentionConfig  AntiMentionConfig?
  antiRaidConfig     AntiRaidConfig?
  joinSecurityConfig JoinSecurityConfig?
  logConfigs         LogConfiguration[]
  forumLogThreads    ForumLogThread[]
  logEntries         LogEntry[]
  auditLogs          AuditLog[]
}

model GuildSettings {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  moderationEnabled  Boolean  @default(true)
  autoModEnabled     Boolean  @default(true)
  antiSpamEnabled    Boolean  @default(true)
  antiLinkEnabled    Boolean  @default(true)
  antiInviteEnabled  Boolean  @default(true)
  antiMentionEnabled Boolean  @default(true)
  antiRaidEnabled    Boolean  @default(true)
  raidModeActive     Boolean  @default(false)
  muteRoleId         String?
  quarantineRoleId   String?
  modLogChannelId    String?
  alertChannelId     String?
  appealUrl          String?
  dmOnPunish         Boolean  @default(true)
  timezone           String   @default("UTC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model StaffRole {
  id          String            @id @default(cuid())
  guildId     String
  roleId      String
  roleName    String
  roleColor   String            @default("#5865F2")
  permissions StaffPermission[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId])
  @@index([guildId])
}

model ModerationCase {
  id              String           @id @default(cuid())
  caseNumber      Int
  guildId         String
  targetId        String
  targetTag       String
  targetAvatar    String?
  moderatorId     String
  moderatorTag    String
  action          ModerationAction
  reason          String?          @default("No reason provided")
  durationMinutes Int?
  metadata        Json?            @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
  @@index([guildId, action])
  @@index([guildId, createdAt])
}

model Warning {
  id            String    @id @default(cuid())
  warningNumber Int
  guildId       String
  userId        String
  userTag       String
  moderatorId   String
  moderatorTag  String
  reason        String
  isActive      Boolean   @default(true)
  caseId        String?
  createdAt     DateTime  @default(now())
  removedAt     DateTime?
  removedById   String?
  removedByTag  String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, isActive])
  @@index([guildId, createdAt])
}

model WarningEscalationRule {
  id              String           @id @default(cuid())
  guildId         String
  warnCount       Int
  action          EscalationAction
  durationMinutes Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, warnCount])
  @@index([guildId])
}

model MemberNote {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  authorId  String
  authorTag String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
}

model AutoModRule {
  id                     String        @id @default(cuid())
  guildId                String
  ruleType               AutoModType
  enabled                Boolean       @default(true)
  action                 AutoModAction @default(DELETE)
  timeoutDurationMinutes Int?          @default(10)
  threshold              Int           @default(5)
  timeWindowSeconds      Int           @default(5)
  patterns               String[]      @default([])
  exemptRoleIds          String[]      @default([])
  exemptChannelIds       String[]      @default([])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, ruleType])
  @@index([guildId])
}

model AntiSpamConfig {
  id                String        @id @default(cuid())
  guildId           String        @unique
  enabled           Boolean       @default(true)
  maxMessages       Int           @default(5)
  timeWindowSeconds Int           @default(5)
  maxDuplicates     Int           @default(3)
  action            AutoModAction @default(TIMEOUT)
  timeoutMinutes    Int           @default(10)
  deleteMessages    Boolean       @default(true)
  exemptRoleIds     String[]      @default([])
  exemptChannelIds  String[]      @default([])
  updatedAt         DateTime      @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AntiLinkConfig {
  id                 String        @id @default(cuid())
  guildId            String        @unique
  enabled            Boolean       @default(true)
  blockAll           Boolean       @default(false)
  whitelistedDomains String[]      @default([])
  blacklistedDomains String[]      @default([])
  allowDiscordLinks  Boolean       @default(true)
  allowYouTube       Boolean       @default(true)
  allowTwitch        Boolean       @default(true)
  action             AutoModAction @default(DELETE)
  timeoutMinutes     Int           @default(10)
  exemptRoleIds      String[]      @default([])
  exemptChannelIds   String[]      @default([])
  updatedAt          DateTime      @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AntiInviteConfig {
  id               String        @id @default(cuid())
  guildId          String        @unique
  enabled          Boolean       @default(true)
  action           AutoModAction @default(DELETE)
  timeoutMinutes   Int           @default(10)
  deleteMessage    Boolean       @default(true)
  exemptRoleIds    String[]      @default([])
  exemptChannelIds String[]      @default([])
  updatedAt        DateTime      @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AntiMentionConfig {
  id               String        @id @default(cuid())
  guildId          String        @unique
  enabled          Boolean       @default(true)
  maxUserMentions  Int           @default(5)
  maxRoleMentions  Int           @default(3)
  blockEveryone    Boolean       @default(true)
  blockHere        Boolean       @default(true)
  action           AutoModAction @default(DELETE)
  timeoutMinutes   Int           @default(10)
  exemptRoleIds    String[]      @default([])
  exemptChannelIds String[]      @default([])
  updatedAt        DateTime      @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AntiRaidConfig {
  id             String     @id @default(cuid())
  guildId        String     @unique
  enabled        Boolean    @default(true)
  joinThreshold  Int        @default(10)
  windowSeconds  Int        @default(10)
  action         RaidAction @default(LOCK_CHANNELS)
  lockChannelIds String[]   @default([])
  alertChannelId String?
  autoRaidMode   Boolean    @default(true)
  updatedAt      DateTime   @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model JoinSecurityConfig {
  id                  String             @id @default(cuid())
  guildId             String             @unique
  enabled             Boolean            @default(false)
  minAccountAgeDays   Int                @default(7)
  blockDefaultAvatars Boolean            @default(false)
  action              JoinSecurityAction @default(ALERT)
  quarantineRoleId    String?
  updatedAt           DateTime           @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model LogConfiguration {
  id              String             @id @default(cuid())
  guildId         String
  category        LogCategory
  enabled         Boolean            @default(true)
  destinationType LogDestinationType @default(TEXT_CHANNEL)
  channelId       String?
  forumThreadMode ForumThreadMode    @default(CATEGORY)
  showIds         Boolean            @default(true)
  showModerator   Boolean            @default(true)
  showReason      Boolean            @default(true)
  showChannel     Boolean            @default(true)
  showTimestamp   Boolean            @default(true)
  showBeforeAfter Boolean            @default(true)
  mentionUsers    Boolean            @default(false)
  embedColor      String             @default("#5865F2")
  updatedAt       DateTime           @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, category])
  @@index([guildId])
}

model ForumLogThread {
  id             String          @id @default(cuid())
  guildId        String
  forumChannelId String
  category       LogCategory
  threadKey      String
  threadId       String
  threadName     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, forumChannelId, threadKey])
  @@index([guildId, forumChannelId])
}

model LogEntry {
  id          String      @id @default(cuid())
  guildId     String
  category    LogCategory
  eventType   String
  targetId    String?
  targetTag   String?
  executorId  String?
  executorTag String?
  channelId   String?
  details     Json
  createdAt   DateTime    @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, category, createdAt])
  @@index([guildId, eventType])
}

model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  username      String
  discriminator String    @default("0")
  avatar        String?
  email         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  accessToken  String?
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String      @id @default(cuid())
  guildId   String
  userId    String
  userTag   String
  action    AuditAction
  details   Json
  ipAddress String?
  createdAt DateTime    @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, action])
}
