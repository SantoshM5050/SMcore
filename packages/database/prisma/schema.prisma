generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id          String   @id // Discord Snowflake ID
  name        String
  icon        String?
  ownerId     String   // Discord Snowflake ID of guild owner
  botPresent  Boolean  @default(true)
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings         GuildSettings?
  moderationCases  ModerationCase[]
  warnings         Warning[]
  escalationRules  WarningEscalationRule[]
  memberNotes      MemberNote[]

  @@index([ownerId])
  @@map("guilds")
}

model GuildSettings {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  guild               Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  prefix              String   @default("!")
  language            String   @default("en-US")
  timezone            String   @default("UTC")
  modLogChannelId     String?
  actionLogChannelId  String?
  muteRoleId          String?
  appealUrl           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([guildId])
  @@map("guild_settings")
}

model ModerationCase {
  id              String    @id @default(cuid())
  guildId         String
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  caseNumber      Int
  type            String    // BAN, UNBAN, KICK, TIMEOUT, UNTIMEOUT, WARN, PURGE, LOCK, UNLOCK, SLOWMODE, NICKNAME
  targetUserId    String    // Discord Snowflake ID
  moderatorUserId String    // Discord Snowflake ID
  reason          String?
  duration        Int?      // in seconds
  expiresAt       DateTime?
  status          String    @default("ACTIVE") // ACTIVE, COMPLETED, REVOKED, EXPIRED
  metadata        Json?

  warnings        Warning[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetUserId])
  @@index([moderatorUserId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("moderation_cases")
}

model Warning {
  id              String          @id @default(cuid())
  guildId         String
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)

  targetUserId    String          // Discord Snowflake ID
  moderatorUserId String          // Discord Snowflake ID
  reason          String
  status          String          @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt       DateTime?

  caseId          String?
  case            ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([guildId])
  @@index([targetUserId])
  @@index([status])
  @@map("warnings")
}

model WarningEscalationRule {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  warningCount Int
  action       String   // BAN, KICK, TIMEOUT
  duration     Int?     // duration in seconds if action is TIMEOUT
  enabled      Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, warningCount])
  @@index([guildId])
  @@map("warning_escalation_rules")
}

model MemberNote {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  targetUserId String   // Discord Snowflake ID
  authorUserId String   // Discord Snowflake ID (staff member)
  content      String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guildId])
  @@index([targetUserId])
  @@map("member_notes")
}
